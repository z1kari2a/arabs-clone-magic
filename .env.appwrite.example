# Appwrite — انسخ هذا الملف إلى .env.appwrite واملأ المفتاح.
# .env.appwrite مُستثنى من git ولا يُرفع إلى GitHub إطلاقاً.

APPWRITE_ENDPOINT="https://nyc.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="ضع-القيمة-هنا"
APPWRITE_DATABASE_ID="ضع-القيمة-هنا"

# مفتاح API من Appwrite Console → Overview → Integrations → API Keys
# الصلاحيات المطلوبة: databases.read, databases.write,
#                     collections.read, collections.write,
#                     attributes.read, attributes.write,
#                     indexes.read, indexes.write,
#                     documents.read, documents.write
APPWRITE_API_KEY="ضع-القيمة-هنا"

# مسار قاعدة SQLite المحلية (اختياري — يُكتشف تلقائياً من مجلد بيانات Electron)
# APPWRITE_SQLITE_PATH="/root/.config/ERP/erp.db"

# نطاق المستخدم المحلي المراد مزامنته (اختياري).
# الجداول suppliers/items/purchase_orders/purchase_requests/audit_log مخزَّنة
# لكل مستخدم على حدة داخل SQLite، فهذا يحدد أي مستخدم تتم مزامنته.
# اتركه فارغاً لمزامنة كل النطاقات الموجودة محلياً.
# APPWRITE_SYNC_SCOPE=""
